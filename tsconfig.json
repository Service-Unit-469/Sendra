{
  "compilerOptions": {
    "target": "es2020",
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "emitDecoratorMetadata": true,
    "declaration": true,
    "experimentalDecorators": true,
    "paths": {
      "@service-unit-469/sendra-lib": [
        "./packages/lib/"
      ],
      "@service-unit-469/sendra-shared": [
        "./packages/shared/"
      ],
      "@service-unit-469/sendra-test": [
        "./packages/test/"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ]
}
