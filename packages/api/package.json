{
	"name": "@service-unit-469/sendra-api",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Service-Unit-469/Sendra.git"
	},
	"main": "dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./handler": {
			"types": "./dist/app.d.ts",
			"default": "./dist/app.js"
		}
	},
	"private": false,
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"files": ["dist/**"],
	"scripts": {
		"build": "tsc && pnpm run openapi:export && pnpm run openapi:validate",
		"dev": "tsc --watch --preserveWatchOutput",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"lint:fix:unsafe": "biome check --write src --unsafe",
		"typecheck": "tsc --noEmit",
		"clean": "rimraf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"openapi:export": "tsx scripts/export-openapi.ts",
		"openapi:validate": "pnpm --package=@seriousme/openapi-schema-validator dlx validate-api ../../docs/openapi.json"
	},
	"devDependencies": {
		"@service-unit-469/sendra-test": "workspace:*",
		"@types/compression": "catalog:",
		"@types/jsonwebtoken": "catalog:",
		"@types/ms": "^2.1.0",
		"sst": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "catalog:",
		"@aws-sdk/client-s3": "catalog:",
		"@aws-sdk/client-ses": "catalog:",
		"@aws-sdk/lib-dynamodb": "catalog:",
		"@aws-sdk/s3-request-presigner": "catalog:",
		"@hono/zod-openapi": "catalog:",
		"@service-unit-469/sendra-lib": "workspace:*",
		"@service-unit-469/sendra-shared": "workspace:*",
		"ajv": "catalog:",
		"ajv-formats": "catalog:",
		"aws-embedded-metrics": "catalog:",
		"dayjs": "catalog:",
		"hono": "catalog:",
		"hono-pino": "catalog:",
		"jsonwebtoken": "catalog:",
		"lru-cache": "^11.5.2",
		"ms": "^2.1.3",
		"zod": "catalog:"
	}
}
