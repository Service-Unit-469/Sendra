{
	"name": "@service-unit-469/sendra-subscribers",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Service-Unit-469/Sendra.git"
	},
  "exports": {
    "./email-topic-handler": {
			"types": "./dist/EmailTopicSubscriber.d.ts",
			"default": "./dist/EmailTopicSubscriber.js"
		},
		"./task-queue-handler": {
			"types": "./dist/TaskQueueSubscriber.d.ts",
			"default": "./dist/TaskQueueSubscriber.js"
		}
	},
	"private": false,
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"files": ["dist/**"],
	"scripts": {
		"prepack": "pnpm run build",
		"build": "tsc",
		"dev": "tsc --watch --preserveWatchOutput",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"lint:fix:unsafe": "biome check --write src --unsafe",
		"typecheck": "tsc --noEmit",
		"clean": "rimraf dist",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@aws-sdk/client-dynamodb": "catalog:",
		"@service-unit-469/sendra-test": "workspace:*",
		"@types/aws-lambda": "catalog:",
		"sst": "catalog:",
		"ts-node-dev": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@aws-sdk/client-sns": "catalog:",
		"@service-unit-469/sendra-lib": "workspace:*",
		"@service-unit-469/sendra-shared": "workspace:*",
		"aws-embedded-metrics": "catalog:",
		"pino": "catalog:",
		"zod": "catalog:"
	}
}
